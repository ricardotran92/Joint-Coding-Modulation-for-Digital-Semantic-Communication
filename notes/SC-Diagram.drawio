        <mxCell id="SchegyADvhLZFACHOGxH-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;dashed=1;dashPattern=12 12;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;probability mapping (q)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;*type: probability tensor&lt;/div&gt;&lt;div&gt;*shape: ℝ^{n × M}&lt;/div&gt;&lt;div&gt;&amp;nbsp; +&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Σ q_im = 1;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;q ∈ ℝ^{n×M}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; + n: channel number (e.g. 128)&lt;/div&gt;&lt;div&gt;&amp;nbsp; + M: modulation order e.g. 4, 16)&lt;/div&gt;&lt;div&gt;*value:&amp;nbsp;q_i = [q_i1, q_i2, ..., q_iM] with&amp;nbsp;∑ q_im = 1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
