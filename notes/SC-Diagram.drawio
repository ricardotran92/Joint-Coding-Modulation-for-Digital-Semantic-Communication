        <mxCell id="ZWz4r8QUu9HOM2SrYpOj-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;symbol Z&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;*type:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;discrete symbol sequence&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*shape:&amp;nbsp;ℂ^n hoặc ℝ^n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&amp;nbsp;C = constellation set&lt;/span&gt;&lt;/div&gt;&lt;div&gt;*value:&lt;/div&gt;&lt;div&gt;&amp;nbsp; + BPSK: Z= [+1, -1, +1, ...]&lt;/div&gt;&lt;div&gt;&amp;nbsp; + 4-QAM:&amp;nbsp; Z= [(+1,+1), (-1,+1), (-1,-1), (+1,-1)]&lt;/div&gt;&lt;div&gt;&amp;nbsp; + 16-QAM: Z = [(-3,-3), (-3,-1), ..., (+3,+3)]&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="190" x="510" y="276.5" as="geometry" />
        </mxCell>
        <mxCell id="SchegyADvhLZFACHOGxH-15" edge="1" parent="1" source="ZWz4r8QUu9HOM2SrYpOj-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;dashed=1;dashPattern=1 4;">
          <mxGeometry relative="1" as="geometry">
