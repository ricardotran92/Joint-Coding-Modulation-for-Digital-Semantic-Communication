        <mxCell id="hsQFi3ksXS95psjEBy0G-2" parent="k20ppoUpB564TTnjl1qa-1" style="text;whiteSpace=wrap;html=1;strokeColor=default;" value="&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;516&quot; data-end=&quot;572&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;span&gt;h = [0.2, -1.1, 0.5, 2.0, -0.3, 1.2]   (1×6)&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;↓ (Linear) &lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;logits = h · W + b&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;W ∈ ℝ^{6×12}   (vì n=3, M=4 → 3×4 = 12)&lt;/span&gt;&lt;/div&gt;b ∈ ℝ^{12}&lt;/div&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;696&quot; data-end=&quot;726&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;p data-start=&quot;728&quot; data-end=&quot;741&quot;&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-scroller&quot;&gt;logits = [&lt;br&gt;  1.0, 4.0, 0.5, 0.3,     ← 4 giá trị đầu&lt;br&gt;  2.0, 2.0, 3.5, 1.0,     ← tiếp&lt;br&gt;  3.0, 1.0, 1.0, 2.0      ← tiếp&lt;br&gt;]&lt;br&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;↓ reshape&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; white-space: normal;&quot;&gt;&amp;nbsp;(3×4)&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;[&lt;br&gt;  [1.0, 4.0, 0.5, 0.3],&lt;br&gt;  [2.0, 2.0, 3.5, 1.0],&lt;br&gt;  [3.0, 1.0, 1.0, 2.0]&lt;br&gt;]&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;↓ softmax&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;q = [&lt;br/&gt;  [0.01, 0.97, 0.01, 0.01],&lt;br/&gt;  [0.2,  0.2,  0.5,  0.1 ],&lt;br/&gt;  [0.6,  0.1,  0.1,  0.2 ]&lt;br/&gt;]&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&