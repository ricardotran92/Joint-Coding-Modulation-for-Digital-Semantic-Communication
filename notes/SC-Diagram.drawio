          </mxGeometry>
        </mxCell>
        <mxCell id="ZWz4r8QUu9HOM2SrYpOj-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Ẑ&lt;/b&gt;&lt;/div&gt;&lt;div&gt;*type: continuous noisy signal&lt;/div&gt;&lt;div&gt;*shape:&amp;nbsp;Ẑ ∈ C^n (or R^n)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*value:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Ẑ = Z + ε&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; e.g.,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Z = +1;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ε = -0.18&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;→ Ẑ = 0.82&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="190" x="750" y="290" as="geometry" />
        </mxCell>
        <mxCell id="SchegyADvhLZFACHOGxH-13" edge="1" parent="1" source="ZWz4r8QUu9HOM2SrYpOj-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=1 4;endArrow=none;endFill=0;" target="ZWz4r8QUu9HOM2SrYpOj-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZWz4r8QUu9HOM2SrYpOj-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;i&gt;[training]&lt;/i&gt; sampling via Gumbel-Softmax&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;softmax(log(q) + gumbel noise)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;→ y (continuous, differentiable)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="144.5" x="380.75" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ZWz4r8QUu9HOM2SrYpOj-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Ŝ&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;*type: probability vector (softmax output)&lt;/div&gt;&lt;div&gt;*shape: ℝ^L  (L = number of classes)&lt;/div&gt;&lt;div&gt;*value: [0.01, 0.9, 0.02, ...] → argmax → label&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="190" x="1070" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ZWz4r8QUu9HOM2SrYpOj-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;X̂&lt;/b&gt;&lt;div style=&quot;text-align: left;&quot;&gt;*type: tensor float&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;*shape: R^{32x32x3}&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: left; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*value: [0, 1] or [-1, 1&lt;/span&gt;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="140" x="1100" y="160" as="geometry" />
        </mxCell>
